{
	"name": "@grocery-split/api",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"exports": {
		"import": "./src/index.ts",
		"require": null
	},
	"scripts": {
		"format": "prettier --write --ignore-unknown .",
		"lint": "eslint .",
		"check": "wrangler types --check --env-interface CloudflareBindings && tsc --noEmit",
		"pre-commit": "lint-staged",
		"dev": "wrangler dev src/index.ts",
		"build": "tsc",
		"preview": "pnpm run build && wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"test": "vitest"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.6.0",
		"@grocery-split/db": "workspace:*",
		"@grocery-split/eslint-config": "workspace:*",
		"@grocery-split/prettier-config": "workspace:*",
		"@grocery-split/validation": "workspace:*",
		"@tsconfig/node-ts": "^23.6.4",
		"@tsconfig/node26": "^26.0.1",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.4",
		"eslint": "^10.10.0",
		"lint-staged": "^17.5.1",
		"prettier": "3.9.6",
		"typescript": "~6.0.3",
		"vitest": "^4.1.12",
		"wrangler": "^4.156.0"
	},
	"lint-staged": {
		"*.*": [
			"pnpm run format",
			"pnpm run lint"
		]
	},
	"prettier": "@grocery-split/prettier-config",
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.7",
		"better-auth": "^1.7.7",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.13",
		"nanoid": "^6.0.2",
		"zod": "^4.6.5"
	}
}
