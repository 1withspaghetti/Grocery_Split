{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grocery-split",
	"main": "dist/index.js",
	// Set this to today's date
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_als"],
	// "assets": {
	// 	"binding": "ASSETS",
	// 	"directory": "dist",
	// },
	"routes": [
		{
			"pattern": "grocery-split-api.tyler.place",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "GROCERY_SPLIT_DB",
			"database_id": "75fa1a8b-1a8b-4e1a-a5b4-f27c2d251ace",
			"migrations_dir": "../db/migrations",
			"migrations_pattern": "../db/migrations/*/migration.sql"
		}
	]
}
