{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "grocery-split-frontend",
	// Set this to today's date
	"compatibility_date": "2026-10-30",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "grocery-split.tyler.place",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
